{
  "name": "moy-ritm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "«Мой ритм» — планировщик задач и трекер привычек (MVP)",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tz": "TZ=Europe/Moscow vitest run && TZ=America/New_York vitest run",
    "test:e2e": "playwright test",
    "test:e2e:tz": "TZ=Europe/Moscow playwright test && TZ=America/New_York playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "build:deploy": "node scripts/build-deploy.mjs",
    "test:deploy": "playwright test -c deploy/playwright.config.ts",
    "lighthouse": "lhci autorun --config=lighthouse/mobile.json && lhci autorun --config=lighthouse/desktop.json",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/onest": "^5.2.0",
    "@fontsource/unbounded": "^5.2.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "fractional-indexing": "^3.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
